---
import Base from '../../layouts/Base.astro';
---
<Base title="Control — 33r" noindex jsonLd={false}>
  <div id="app" class="ctl"><p class="tag" style="padding:2rem">Cargando…</p></div>
  <script>import '../../scripts/control/app.js';</script>
</Base>
<style is:global>
  .ctl { --good: #7be0b5; --bad: #ff8a8a; --warn: #f0c261; width: min(100% - 2rem, 1320px); margin-inline: auto; padding-block: 1.4rem 5rem; }
  .ctl h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); } .ctl h2 { font-size: 1.05rem; letter-spacing: -.01em; line-height: 1.2; }
  .ctl .muted { color: var(--ash); } .ctl small { font-size: .78rem; } .ctl code { font: 500 .85em var(--f-mono); background: var(--graphite); padding: .1em .4em; border-radius: 4px; }
  .ctl .top { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: end; margin-bottom: 1rem; } .ctl .brand { display: grid; gap: .4rem; } .ctl .who { display: flex; gap: .7rem; align-items: center; }
  .ctl .banner { background: rgba(240, 194, 97, .1); border: 1px solid rgba(240, 194, 97, .4); color: var(--bone); border-radius: 12px; padding: .8rem 1rem; font-size: .9rem; margin-bottom: 1rem; } .ctl .banner.err { background: rgba(255, 138, 138, .1); border-color: rgba(255, 138, 138, .45); }
  .ctl .tabs { display: flex; gap: .3rem; overflow-x: auto; border-bottom: 1px solid var(--mist); margin-bottom: 1.4rem; scrollbar-width: none; } .ctl .tabs a { text-decoration: none; padding: .85rem 1rem; font: 500 .74rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ash); white-space: nowrap; border-bottom: 2px solid transparent; }
  .ctl .tabs a:hover { color: var(--bone); } .ctl .tabs a[aria-current=page] { color: var(--ecto); border-color: var(--ecto); }
  .ctl .kpis { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 1rem; }
  .ctl .kpi { background: var(--graphite); border: 1px solid var(--mist); border-radius: 14px; padding: 1rem 1.1rem; display: grid; gap: .45rem; align-content: start; min-width: 0; } .ctl .kpi b { font: 700 clamp(1.4rem, 2.6vw, 1.9rem) var(--f-display); letter-spacing: -.03em; overflow-wrap: anywhere; } .ctl .kpi small { color: var(--ash); }
  .ctl .kpi.good b { color: var(--good); } .ctl .kpi.bad b { color: var(--bad); } .ctl .kpi.bad { border-color: rgba(255, 138, 138, .35); }
  .ctl .two { display: grid; gap: 1rem; margin-bottom: 1rem; align-items: start; } @media (min-width: 980px) { .ctl .two { grid-template-columns: 1.4fr 1fr; } }
  .ctl .panel { background: var(--graphite); border: 1px solid var(--mist); border-radius: 14px; padding: 1.1rem 1.2rem; min-width: 0; } .ctl .ph { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .6rem; margin-bottom: 1rem; }
  .ctl .lg { display: flex; gap: .5rem; align-items: center; font-size: .78rem; color: var(--ash); } .ctl .lg i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; } .ctl .lg i + * {} .ctl .lg .in { background: var(--ecto); } .ctl .lg .co { background: var(--aura); margin-left: .6rem; }
  .ctl svg { width: 100%; height: auto; display: block; overflow: visible; } .ctl svg .grid { stroke: var(--mist); stroke-width: 1; } .ctl svg .ax { fill: var(--ash); font: 500 11px var(--f-mono); } .ctl svg .b-in { fill: var(--ecto); } .ctl svg .b-co { fill: var(--aura); }
  .ctl .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; } .ctl .bars li { display: grid; grid-template-columns: minmax(6rem, 28%) 1fr auto; gap: .8rem; align-items: center; font-size: .9rem; } .ctl .bt { height: 10px; background: var(--ink); border-radius: 5px; overflow: hidden; } .ctl .bt i { display: block; height: 100%; border-radius: 5px; } .ctl .bars b { font: 500 .8rem var(--f-mono); }
  .ctl .chips { display: flex; flex-wrap: wrap; gap: .4rem; } .ctl .chip { font: 500 .72rem var(--f-mono); padding: .25em .6em; border: 1px solid var(--mist); border-radius: 999px; background: var(--ink); white-space: nowrap; }
  .ctl .pill { display: inline-block; font: 600 .68rem var(--f-mono); letter-spacing: .06em; text-transform: uppercase; padding: .3em .7em; border-radius: 999px; border: 1px solid var(--mist); color: var(--bone); white-space: nowrap; }
  .ctl .pill.ok { color: var(--good); border-color: rgba(123, 224, 181, .45); } .ctl .pill.warn { color: var(--warn); border-color: rgba(240, 194, 97, .45); } .ctl .pill.bad { color: var(--bad); border-color: rgba(255, 138, 138, .45); } .ctl .pill.info { color: var(--aura); border-color: rgba(169, 155, 255, .45); } .ctl .pill.mute { color: var(--ash); }
  .ctl .alerts { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; } .ctl .alerts li { padding: .6rem .8rem; border-radius: 10px; font-size: .88rem; border: 1px solid var(--mist); border-left-width: 3px; } .ctl .alerts li.warn { border-left-color: var(--warn); } .ctl .alerts li.info { border-left-color: var(--aura); }
  .ctl .bar2 { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin-bottom: 1rem; } .ctl .bar2 .btn.primary { margin-left: auto; }
  .ctl input, .ctl select, .ctl textarea { font: 400 .92rem var(--f-text); color: var(--bone); background: var(--ink); border: 1px solid var(--mist); border-radius: 10px; padding: .6rem .8rem; min-height: 42px; max-width: 100%; } .ctl textarea { width: 100%; resize: vertical; } .ctl input:focus-visible, .ctl select:focus-visible { outline: 2px solid var(--ecto); outline-offset: 1px; }
  .ctl .btn { min-height: 42px; padding: .55em 1.1em; font-size: .86rem; } .ctl .btn.sm { min-height: 34px; padding: .3em .8em; font-size: .76rem; } .ctl .btn.primary { background: var(--ecto); color: var(--ink); border-color: var(--ecto); } .ctl .btn.danger { color: var(--bad); border-color: rgba(255, 138, 138, .4); }
  .ctl .tbl { overflow-x: auto; background: var(--graphite); border: 1px solid var(--mist); border-radius: 14px; } .ctl table { width: 100%; border-collapse: collapse; font-size: .88rem; min-width: 760px; } .ctl th, .ctl td { text-align: left; padding: .75rem .9rem; border-bottom: 1px solid var(--mist); vertical-align: middle; }
  .ctl th { font: 500 .66rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ash); white-space: nowrap; } .ctl tr:last-child td { border-bottom: 0; } .ctl th.r, .ctl td.r { text-align: right; } .ctl .n { font-family: var(--f-mono); font-size: .84rem; white-space: nowrap; } .ctl .neg { color: var(--bad); } .ctl .warnt { color: var(--warn); }
  .ctl .act { display: flex; gap: .4rem; justify-content: flex-end; } .ctl td a { text-decoration: none; border-bottom: 1px solid var(--mist); } .ctl td a:hover { color: var(--ecto); border-color: var(--ecto); }
  .ctl .empty { display: grid; gap: .8rem; justify-items: start; padding: 2rem; border: 1px dashed var(--mist); border-radius: 14px; color: var(--ash); }
  .ctl .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); } .ctl .country dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin: 0 0 1rem; } .ctl .country dt { font: 500 .62rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ash); } .ctl .country dd { margin: .2rem 0 0; font: 700 1.15rem var(--f-display); letter-spacing: -.02em; overflow-wrap: anywhere; }
  .ctl .plist { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .4rem; font-size: .88rem; }
  .ctl .matrix { min-width: 0; } .ctl .matrix th.v { height: 150px; vertical-align: bottom; padding: .5rem .3rem; } .ctl .matrix th.v span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; } .ctl .matrix td.r { padding: .3rem; text-align: center; }
  .ctl .cell { width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--mist); background: var(--ink); color: var(--ink); cursor: pointer; font-size: 1rem; } .ctl .cell.on { background: var(--ecto); border-color: var(--ecto); } .ctl .cell:hover { border-color: var(--bone); }
  .ctl .seg { display: inline-flex; border: 1px solid var(--mist); border-radius: 999px; overflow: hidden; } .ctl .seg button { font: 600 .8rem var(--f-text); padding: .55rem 1.1rem; background: transparent; color: var(--ash); border: 0; cursor: pointer; } .ctl .seg button[aria-selected=true] { background: var(--bone); color: var(--ink); }
  .ctl .note { color: var(--ash); font-size: .82rem; margin-top: .8rem; max-width: 70ch; } .ctl .stack { display: grid; gap: .6rem; justify-items: start; } .ctl .file { cursor: pointer; }
  .ctl dialog { width: min(96vw, 760px); max-height: 92vh; overflow: auto; background: var(--graphite); color: var(--bone); border: 1px solid var(--mist); border-radius: 16px; padding: 1.4rem; } .ctl dialog::backdrop { background: rgba(0, 0, 0, .7); }
  .ctl .grid2 { display: grid; gap: .9rem; margin-bottom: 1rem; } @media (min-width: 640px) { .ctl .grid2 { grid-template-columns: 1fr 1fr; } } .ctl .grid2 label { display: grid; gap: .35rem; font-size: .8rem; color: var(--ash); } .ctl .grid2 label span { font: 500 .66rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; } .ctl .grid2 label.wide { grid-column: 1 / -1; } .ctl .grid2 input, .ctl .grid2 select { width: 100%; color: var(--bone); }
  .ctl .stsel { min-height: 0; padding: .3rem .4rem; font-size: .8rem; max-width: 9.5rem; } .ctl .checks { display: flex; flex-wrap: wrap; gap: .5rem; } .ctl .chk { display: inline-flex !important; align-items: center; gap: .4rem; font-size: .85rem !important; color: var(--bone) !important; padding: .4rem .7rem; border: 1px solid var(--mist); border-radius: 999px; cursor: pointer; } .ctl .chk input { width: auto; min-height: 0; accent-color: var(--ecto); }
  .ctl .row { display: flex; gap: .6rem; justify-content: flex-end; flex-wrap: wrap; } .ctl .err { color: var(--bad); font-size: .88rem; min-height: 1.2em; }
  .ctl .login { max-width: 400px; display: grid; gap: 1rem; margin: 12vh auto 0; padding: 1.6rem; background: var(--graphite); border: 1px solid var(--mist); border-radius: 16px; } .ctl .login label { display: grid; gap: .4rem; font-size: .8rem; color: var(--ash); } .ctl .login input { width: 100%; }
  .toast { position: fixed; left: 50%; bottom: 1.4rem; transform: translateX(-50%); background: var(--bone); color: var(--ink); padding: .7rem 1.2rem; border-radius: 999px; font: 600 .88rem var(--f-text); z-index: 90; transition: opacity .4s; } .toast.out { opacity: 0; }
  @media (max-width: 600px) { .ctl .bars li { grid-template-columns: 1fr auto; } .ctl .bars .bt { grid-column: 1 / -1; order: 3; } .ctl .bar2 .btn.primary { margin-left: 0; width: 100%; } }
</style>
