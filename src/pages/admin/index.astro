---
import Base from '../../layouts/Base.astro';
---
<Base title="Panel — 33r" noindex jsonLd={false}>
  <main id="main" class="adm"><div id="app" class="wrap"><p class="tag">Cargando…</p></div></main>
  <script>import '../../scripts/admin.js';</script>
</Base>
<style is:global>
  .adm { padding: 2rem 0 6rem; min-height: 100svh; }
  .adm h1 { font-size: var(--step-3); } .adm h2 { font-size: var(--step-2); }
  .adm .bar { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .adm .tabs { display: flex; gap: .5rem; } .adm table { width: 100%; border-collapse: collapse; font-size: .9rem; } .adm th, .adm td { text-align: left; padding: .7rem .5rem; border-bottom: 1px solid var(--mist); vertical-align: middle; }
  .adm th { font: 500 .68rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ash); } .adm .scroll { overflow-x: auto; }
  .adm .btn { min-height: 40px; padding: .5em 1em; font-size: .85rem; } .adm .row { display: flex; gap: .4rem; flex-wrap: wrap; }
  .adm input, .adm select, .adm textarea { font: 400 .95rem var(--f-text); color: var(--bone); background: var(--ink); border: 1px solid var(--mist); border-radius: 8px; padding: .6rem .7rem; width: 100%; }
  .adm textarea { min-height: 84px; resize: vertical; } .adm label { display: grid; gap: .35rem; font: 500 .68rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ash); }
  .adm label.chk { display: flex; align-items: center; gap: .5rem; } .adm label.chk input { width: auto; }
  .adm dialog { width: min(96vw, 860px); max-height: 92vh; overflow: auto; background: var(--graphite); color: var(--bone); border: 1px solid var(--mist); border-radius: var(--radius); padding: 1.5rem; }
  .adm dialog::backdrop { background: rgba(0,0,0,.7); } .adm .grid2 { display: grid; gap: 1rem; } @media (min-width: 700px) { .adm .grid2 { grid-template-columns: 1fr 1fr; } }
  .adm .full { grid-column: 1 / -1; } .adm fieldset { border: 1px solid var(--mist); border-radius: 10px; padding: .8rem; display: flex; gap: .8rem; flex-wrap: wrap; } .adm legend { font: 500 .68rem var(--f-mono); color: var(--ash); text-transform: uppercase; padding: 0 .4rem; }
  .adm .login { max-width: 420px; display: grid; gap: 1rem; margin: 10vh auto 0; } .adm .msg { color: #ff9a9a; } .adm .okmsg { color: var(--ecto); } .adm .thumb { width: 72px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid var(--mist); }
  .adm .st-borrador { color: var(--ash); } .adm .st-pub { color: var(--ecto); }
</style>
