---
const { t } = Astro.props; const e = t.edge;
---
<section class="section edge" aria-labelledby="edge-h">
  <div class="wrap">
    <div class="section__head">
      <p class="tag tag--ecto materialize">{e.eyebrow}</p>
      <h2 id="edge-h" class="materialize" style="--d:.1s">{e.title}</h2>
    </div>
    <ol class="edge__list">
      {e.items.map(([h, p], i) => (
        <li class="materialize" style={`--d:${i * 0.1}s`}><span class="tag tag--ecto">0{i + 1}</span><h3>{h}</h3><p class="muted">{p}</p></li>
      ))}
    </ol>
  </div>
</section>
<style>
  .edge__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--mist); border: 1px solid var(--mist); border-radius: var(--radius); overflow: hidden; }
  .edge__list li { background: var(--ink); padding: clamp(1.5rem, 3vw, 2.2rem); display: grid; gap: .8rem; align-content: start; }
  .edge__list h3 { font-size: var(--step-2); max-width: 20ch; }
  @media (min-width: 760px) { .edge__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .edge__list { grid-template-columns: repeat(4, 1fr); } }
</style>
