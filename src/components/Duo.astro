---
const { t } = Astro.props; const d = t.duo;
---
<section class="section duo" id="sistema" aria-labelledby="duo-h">
  <div class="wrap">
    <div class="section__head">
      <p class="tag tag--ecto materialize">{d.eyebrow}</p>
      <h2 id="duo-h" class="materialize" style="--d:.1s">{d.title}</h2>
      <p class="materialize" style="--d:.2s">{d.intro}</p>
    </div>

    <div class="duo__grid materialize materialize--rise" data-duo data-locale={d.locale} data-currency={d.currency}
      data-labels={JSON.stringify({ empty: d.empty, total: d.total, order: d.order, order_word: d.order_word, newC: d.newCustomer, ret: d.returning })}>
      <div class="col">
        <p class="tag col__label">{d.phoneLabel}</p>
        <div class="phone">
          <div class="phone__notch" aria-hidden="true"></div>
          <div class="phone__screen">
            <header class="shop"><b>{d.shop}</b><span class="tag">{d.shopSub}</span></header>
            <ul class="menu">
              {d.items.map(([name, price], i) => (
                <li data-item={i} data-price={price}>
                  <span class="menu__name">{name}</span>
                  <em>${price.toFixed(2)}</em>
                  <div class="qty">
                    <button type="button" data-rm aria-label={`${d.remove}: ${name}`}>−</button>
                    <output aria-live="off">0</output>
                    <button type="button" data-add aria-label={`${d.add}: ${name}`}>+</button>
                  </div>
                </li>
              ))}
            </ul>
            <div class="cartbar">
              <p><span class="tag" data-cart-label>{d.empty}</span><b data-cart-total></b></p>
              <button type="button" class="btn btn--primary" data-order disabled>{d.order}</button>
            </div>
            <div class="thanks" data-thanks hidden role="status">
              <span class="check" aria-hidden="true">✓</span><b>{d.thanks}</b>
              <button type="button" class="btn" data-again>{d.again}</button>
            </div>
          </div>
        </div>
      </div>

      <div class="wire" aria-hidden="true"><i></i></div>

      <div class="col">
        <p class="tag col__label">{d.panelLabel} <span class="live"><i></i>{d.live}</span></p>
        <div class="dash" role="region" aria-label={d.panelLabel}>
          <div class="kpis">
            <div class="kpi"><span class="tag">{d.kpis.sales}</span><b data-k="sales">—</b></div>
            <div class="kpi"><span class="tag">{d.kpis.orders}</span><b data-k="orders">—</b></div>
            <div class="kpi"><span class="tag">{d.kpis.ticket}</span><b data-k="ticket">—</b></div>
          </div>
          <div class="chart"><svg viewBox="0 0 240 60" preserveAspectRatio="none" aria-hidden="true"><polyline data-spark fill="none" stroke="#9CF6D4" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /><polygon data-spark-fill fill="rgba(156,246,212,.09)" /></svg></div>
          <div class="funnel">
            <p class="tag">{d.funnel}</p>
            {d.funnelSteps.map((s, i) => (
              <div class="frow" data-f={i}><span>{s}</span><div class="bar"><i></i></div><b></b></div>
            ))}
          </div>
          <div class="feed">
            <p class="tag">{d.feed}</p>
            <ul data-feed></ul>
          </div>
        </div>
      </div>
    </div>
    <p class="tag duo__note">{d.demoNote}</p>
  </div>
</section>
<style>
  .duo__grid { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 980px) { .duo__grid { grid-template-columns: minmax(280px, 340px) 70px 1fr; gap: 1rem; align-items: center; } }
  .col { display: grid; gap: .9rem; justify-items: center; } .col:last-child { justify-items: stretch; }
  .col__label { display: flex; align-items: center; gap: .8rem; }
  .live { display: inline-flex; align-items: center; gap: .4rem; color: var(--ecto); } .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--ecto); animation: blink 1.6s infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .phone { width: min(100%, 320px); border-radius: 38px; padding: 11px; background: #1b1b21; border: 1px solid var(--mist); box-shadow: 0 30px 80px -30px rgba(156,246,212,.18); position: relative; }
  .phone__notch { position: absolute; top: 18px; left: 50%; transform: translateX(-50%); width: 84px; height: 22px; background: #000; border-radius: 12px; z-index: 2; }
  .phone__screen { background: var(--ink); border-radius: 28px; padding: 3rem 1rem 1rem; min-height: 520px; display: grid; grid-template-rows: auto 1fr auto; gap: 1rem; position: relative; overflow: hidden; }
  .shop { display: grid; gap: .3rem; } .shop b { font: 600 1.3rem var(--f-display); }
  .menu { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; align-content: start; }
  .menu li { display: grid; grid-template-columns: 1fr auto; gap: .2rem .6rem; align-items: center; background: var(--graphite); border: 1px solid var(--mist); border-radius: 12px; padding: .7rem .8rem; }
  .menu__name { font-weight: 600; font-size: .95rem; } .menu em { font: 500 .8rem var(--f-mono); color: var(--ash); font-style: normal; grid-column: 1; }
  .qty { grid-column: 2; grid-row: 1 / 3; display: flex; align-items: center; gap: .5rem; }
  .qty button { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--mist); background: var(--ink); color: var(--bone); font: 600 1.2rem var(--f-text); cursor: pointer; transition: background .2s, transform .15s; }
  .qty button[data-add] { background: var(--ecto); color: var(--ink); border-color: var(--ecto); } .qty button:active { transform: scale(.92); }
  .qty output { min-width: 1.2ch; text-align: center; font: 600 .95rem var(--f-mono); }
  .cartbar { display: flex; align-items: center; justify-content: space-between; gap: .8rem; border-top: 1px solid var(--mist); padding-top: .9rem; } .cartbar p { display: grid; gap: .15rem; } .cartbar b { font: 600 1.15rem var(--f-display); } .cartbar .btn { min-height: 44px; padding: .6em 1.3em; }
  .cartbar .btn:disabled { opacity: .35; cursor: default; transform: none; box-shadow: none; }
  .thanks { position: absolute; inset: 0; background: var(--ink); display: grid; place-content: center; justify-items: center; gap: 1rem; text-align: center; padding: 2rem; } .thanks[hidden] { display: none; }
  .check { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: var(--ecto); color: var(--ink); font-size: 1.8rem; font-weight: 700; animation: pop .5s var(--ease); } .thanks b { font: 600 1.4rem var(--f-display); }
  @keyframes pop { from { transform: scale(.3); opacity: 0; } }
  .wire { display: none; position: relative; height: 2px; background: linear-gradient(90deg, transparent, var(--mist), transparent); }
  @media (min-width: 980px) { .wire { display: block; } } .wire i { position: absolute; top: -3px; left: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--ecto); opacity: 0; } .wire.go i { animation: ping .9s ease-out; }
  @keyframes ping { 0% { left: 0; opacity: 1; } 100% { left: calc(100% - 8px); opacity: 0; } }
  .dash { background: var(--graphite); border: 1px solid var(--mist); border-radius: var(--radius); padding: 1.1rem; display: grid; gap: 1.1rem; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; } .kpi { background: var(--ink); border: 1px solid var(--mist); border-radius: 10px; padding: .8rem; display: grid; gap: .5rem; min-width: 0; }
  .kpi .tag { font-size: .6rem; } .kpi b { font: 600 clamp(1.05rem, 2.4vw, 1.6rem) var(--f-display); letter-spacing: -.02em; transition: color .4s; } .kpi b.flash { color: var(--ecto); }
  .chart { height: 64px; } .chart svg { width: 100%; height: 100%; }
  .funnel { display: grid; gap: .55rem; } .frow { display: grid; grid-template-columns: 9.5rem 1fr 3.2rem; gap: .7rem; align-items: center; font-size: .82rem; } .frow span { color: var(--ash); } .frow b { font: 500 .78rem var(--f-mono); text-align: right; }
  .bar { height: 8px; background: var(--ink); border-radius: 4px; overflow: hidden; } .bar i { display: block; height: 100%; width: 0; background: var(--ecto); border-radius: 4px; transition: width .7s var(--ease); }
  @media (max-width: 460px) { .frow { grid-template-columns: 7rem 1fr 2.8rem; font-size: .76rem; } }
  .feed ul { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .45rem; min-height: 8.5rem; align-content: start; }
  .feed li { display: flex; justify-content: space-between; gap: 1rem; font-size: .84rem; padding: .5rem .7rem; background: var(--ink); border: 1px solid var(--mist); border-radius: 8px; animation: slide .5s var(--ease); } .feed li small { color: var(--ash); font-family: var(--f-mono); } .feed li.fresh { border-color: var(--ecto); }
  @keyframes slide { from { opacity: 0; filter: blur(6px); } }
  .duo__note { margin-top: 1.5rem; text-align: center; }
</style>
