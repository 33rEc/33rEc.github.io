---
const { t } = Astro.props;
---
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[0, 1].map(() => <ul>{t.ticker.map((x) => <li>{x}</li>)}</ul>)}
  </div>
</div>
<style>
  .ticker { border-block: 1px solid var(--mist); overflow: hidden; background: var(--ink); position: relative; z-index: 1; }
  .ticker__track { display: flex; width: max-content; animation: tick 48s linear infinite; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { font: 500 .74rem var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--ash); padding: 1.15rem 1.6rem; white-space: nowrap; display: flex; align-items: center; gap: 3.2rem; }
  .ticker li::after { content: '✦'; color: var(--ecto); font-size: .6rem; opacity: .7; }
  @keyframes tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } .ticker { overflow-x: auto; } }
</style>
