---
import { site } from '../config/site.js';
const { t } = Astro.props; const w = t.who;
---
<section class="section who" id="quienes" data-spot-area aria-labelledby="who-h">
  <div class="wrap who__in">
    <div class="figs" data-spot aria-hidden="true">
      {[0, 1].map((n) => (
        <svg class={`fig fig${n}`} viewBox="0 0 200 320" fill="none">
          <defs>
            <linearGradient id={`fg${n}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9CF6D4" /><stop offset="1" stop-color="#A99BFF" /></linearGradient>
            <filter id={`fb${n}`}><feGaussianBlur stdDeviation="5" /></filter>
          </defs>
          <g filter={`url(#fb${n})`} fill={`url(#fg${n})`}>
            <ellipse cx="100" cy={n ? 78 : 70} rx="44" ry="52" />
            <path d={n ? 'M12 320c4-86 36-132 88-132s84 46 88 132z' : 'M4 320c6-96 44-142 96-142s90 46 96 142z'} />
          </g>
        </svg>
      ))}
    </div>
    <div class="who__text">
      <h2 id="who-h" class="materialize">{w.title}</h2>
      <p class="muted materialize" style="--d:.15s">{w.text}</p>
      <ul class="names materialize" style="--d:.3s">
        {site.founders.map((f) => <li class="tag">{f.name}{f.role?.[t.lang] ? ` — ${f.role[t.lang]}` : ''}</li>)}
      </ul>
      <p class="tag who__hint">{w.hint}</p>
    </div>
  </div>
</section>
<style>
  .who { overflow: hidden; }
  .who__in { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .who__in { grid-template-columns: 1.1fr 1fr; gap: 4rem; } }
  .figs { --mx: 50%; --my: 45%; display: flex; justify-content: center; align-items: flex-end; gap: clamp(.5rem, 4vw, 2.5rem); height: clamp(220px, 34vw, 400px); order: 2;
    --lit: radial-gradient(circle 150px at var(--mx) var(--my), #000 0%, rgba(0,0,0,.35) 60%, rgba(0,0,0,.08) 100%);
    -webkit-mask-image: var(--lit); mask-image: var(--lit); }
  @media (min-width: 900px) { .figs { order: 0; } }
  .fig { height: 100%; width: auto; opacity: .9; } .fig1 { height: 92%; }
  html[data-motion='off'] .figs { -webkit-mask-image: none; mask-image: none; opacity: .4; }  /* versión estática: siluetas tenues */
  .who__text { display: grid; gap: 1.25rem; } .who__text h2 { font-size: var(--step-4); max-width: 12ch; }
  .names { list-style: none; margin: .5rem 0 0; padding: 0; display: grid; gap: .5rem; }
</style>
